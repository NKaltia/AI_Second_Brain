# PostgreSQL connection string (local Docker or Neon in production)
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/second_brain_db"

# Google Gemini API key from AI Studio
GEMINI_API_KEY="your-gemini-api-key"

# Secret for signing JWTs — at least 32 characters; never reuse the production value locally
JWT_SECRET="generate-with-openssl-rand-base64-48"

# HTTP port (optional; defaults to 3000)
PORT=3000

# Node environment (optional; defaults to development)
NODE_ENV=development
